{
  "name": "icloud-sync",
  "version": "1.0.0",
  "description": "Symlink directories in $HOME into iCloud Drive, with a safe backup of whatever was there before.",
  "license": "MIT",
  "author": "Kyler Jensen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylerjensen/icloud-sync.git"
  },
  "homepage": "https://github.com/kylerjensen/icloud-sync#readme",
  "bugs": {
    "url": "https://github.com/kylerjensen/icloud-sync/issues"
  },
  "keywords": [
    "icloud",
    "icloud-drive",
    "symlink",
    "macos",
    "sync"
  ],
  "type": "module",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "icloud-sync": "dist/icloud-sync.mjs"
  },
  "files": [
    "dist/icloud-sync.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "7.8.6",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.22.0"
}
